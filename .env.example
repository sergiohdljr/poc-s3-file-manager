# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/s3_file_manager_dev"
PG_SCHEMA=File_Manager

# API
API_PORT=3000
API_JWT_SECRET=change_me_in_production

# Web
VITE_API_URL=http://localhost:3000

# ── Amazon S3 (AWS) ──────────────────────────────────────────────────────────
# Região: S3 → seu bucket → Propriedades → Região da AWS (ex.: sa-east-1)
AWS_REGION=

# Bucket: S3 → Buckets → nome do bucket que você criou
S3_BUCKET=

# Credenciais IAM: IAM → Usuários → seu usuário → Credenciais → Criar chave de acesso
# Use um usuário com permissão apenas neste bucket (não use a conta root).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Não defina S3_ENDPOINT nem S3_FORCE_PATH_STYLE na AWS — o SDK usa o endpoint oficial.
# (Essas variáveis existem só para emuladores locais tipo MinIO.)
